RewriteEngine On
# RewriteBase /hotel/

# ─── ARCHIVOS ESTÁTICOS: servir directamente ───────────────
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ─── ASSETS: redirigir a public/assets/ ─────────────────────
RewriteRule ^assets/(.*)$ public/assets/$1 [L]

# ─── AJAX: alias api/ → ajax/ (compatibilidad con JS existente)
RewriteRule ^api/(.*)$ ajax/$1 [L,QSA]

# ─── TODAS LAS DEMÁS PETICIONES → Front Controller ─────────
RewriteRule ^(.*)$ public/index.php [L,QSA]
